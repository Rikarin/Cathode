{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "tags": ["type:app"],
  "implicitDependencies": ["editor"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["editor"], "target": "build" }],
      "outputs": ["{workspaceRoot}/dist/apps/desktop"],
      "options": {
        "commands": [
          "tsc -p apps/desktop/tsconfig.json --noEmit",
          "esbuild apps/desktop/src/main.ts apps/desktop/src/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --sourcemap --outdir=dist/apps/desktop"
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": { "command": "electron dist/apps/desktop/main.js" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "playwright test --config apps/desktop/e2e/playwright.config.ts" }
    }
  }
}
