{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "tags": ["type:app"],
  "implicitDependencies": ["editor"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["editor"], "target": "build" }],
      "outputs": ["{workspaceRoot}/dist/apps/desktop"],
      "options": {
        "commands": [
          "tsc -p apps/desktop/tsconfig.json --noEmit",
          "esbuild apps/desktop/src/main.ts apps/desktop/src/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --sourcemap --outdir=dist/apps/desktop",
          "node -e \"require('node:fs').copyFileSync('apps/desktop/assets/icon.png', 'dist/apps/desktop/icon.png')\""
        ],
        "parallel": false
      }
    },
    "engine": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/engine"],
      "options": { "command": "node apps/desktop/scripts/publish-engine.mjs" }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "engine"],
      "outputs": ["{workspaceRoot}/dist/release"],
      "options": { "command": "node apps/desktop/scripts/package.mjs" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": { "command": "node apps/desktop/scripts/serve.mjs" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "playwright test --config apps/desktop/e2e/playwright.config.ts" }
    }
  }
}
