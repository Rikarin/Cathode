<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Spike S2 (docs/adr/0001-process-model.md): does an in-process REST server disturb the audio callback?
    Framework-dependent on purpose, so GC modes can be switched per run with DOTNET_gc* environment variables.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>false</IsAotCompatible>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Throwaway measurement code: keep it readable rather than analyzer-clean. -->
    <NoWarn>$(NoWarn);CA1303;CA2007;CA1031;CA5394;CA1812;CA1852;CA1515;CA1307;CA1305;CA2000;CA1849;CA1848;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Cathode.Audio/Cathode.Audio.csproj"/>
    <ProjectReference Include="../../src/Cathode.Dsp.Native/Cathode.Dsp.Native.csproj"/>
  </ItemGroup>
</Project>
