<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="'$(MSBuildProjectName)' != 'Cathode.Testing'">true</IsTestProject>
    <OutputType Condition="'$(IsTestProject)' == 'true'">Exe</OutputType>
    <!-- Test code favours readability over analyzer strictness. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861;CA2007;CA1822;CA1859;CA5394</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="CsCheck"/>
    <Using Include="Xunit"/>
  </ItemGroup>
</Project>
