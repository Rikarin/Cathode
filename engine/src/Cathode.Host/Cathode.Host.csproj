<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cathode-host</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Real-time host: workstation, non-concurrent GC with a large gen0 budget (see docs/02-architecture.md §2). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Cathode.Audio/Cathode.Audio.csproj"/>
    <ProjectReference Include="../Cathode.Dsp.Native/Cathode.Dsp.Native.csproj"/>
  </ItemGroup>
</Project>
