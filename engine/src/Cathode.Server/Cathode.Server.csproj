<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>REST and WebSocket API for Cathode: presets, scenes, channels, assets; drives the engine host over IPC.</Description>
    <AssemblyName>cathode-server</AssemblyName>
    <RootNamespace>Cathode.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- The native shims belong to cathode-host, which is published beside it (Directory.Build.targets). -->
    <CathodeNativeShims>false</CathodeNativeShims>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
  </ItemGroup>
  <!-- The factory bank (Stores/FactoryPresets.cs): one preset file each, and the bank's order, built into the Server. -->
  <ItemGroup>
    <EmbeddedResource Include="Factory/bank.json" LogicalName="factory/bank.json"/>
    <EmbeddedResource Include="Factory/presets/*.cthpreset" LogicalName="factory/presets/%(Filename)%(Extension)"/>
    <!-- The factory assets (Stores/FactoryAssets.cs): impulse responses rendered from Cathode's own cab model. -->
    <EmbeddedResource Include="Factory/assets/*.wav;Factory/assets/*.cabgrid;Factory/assets/*.nam;Factory/assets/*.aidax" LogicalName="factory/assets/%(Filename)%(Extension)"/>
    <Content Remove="Factory/**"/>
  </ItemGroup>
  <!-- No engine host, audio or native code: the Server talks to cathode-host over IPC (docs/02-architecture.md §3).
       Cathode.Engine (managed, over Cathode.Dsp) is here for the rig parameters, the modifier names and the
       shared-memory telemetry layout it reads; Cathode.Dsp for the block descriptors, IR tools and analysis. -->
  <ItemGroup>
    <ProjectReference Include="../Cathode.Contracts/Cathode.Contracts.csproj"/>
    <ProjectReference Include="../Cathode.Ipc/Cathode.Ipc.csproj"/>
    <ProjectReference Include="../Cathode.Dsp/Cathode.Dsp.csproj"/>
    <ProjectReference Include="../Cathode.Engine/Cathode.Engine.csproj"/>
  </ItemGroup>
  <!-- A self-contained publish carries the .NET runtime and ASP.NET Core (MIT): their licence and third-party notices,
       from the runtime packs, go with it into licenses/dotnet, and the installers ship that folder
       (THIRD-PARTY-NOTICES.md).
       Only the packs of the frameworks this project references are read: ResolvedRuntimePack also lists packs the
       SDK keeps for a transitive reference and never downloads (Microsoft.WindowsDesktop.App on Windows). The files
       are found by wildcard because the packs do not agree on the extension's case (LICENSE.TXT in
       Microsoft.NETCore.App, LICENSE.txt in Microsoft.AspNetCore.App), which matters on Linux. -->
  <Target Name="CopyRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_RuntimePackByFramework Include="@(ResolvedRuntimePack->'%(FrameworkName)')"/>
      <_ReferencedRuntimePack Include="@(_RuntimePackByFramework)"
                              Condition="'@(FrameworkReference)' != '' and '@(_RuntimePackByFramework)' != '' and '%(Identity)' != ''"/>
      <RuntimeNotice Include="%(_ReferencedRuntimePack.PackageDirectory)/LICENSE.*;%(_ReferencedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.*"
                     Framework="%(_ReferencedRuntimePack.Identity)"/>
    </ItemGroup>
    <PropertyGroup>
      <_RuntimeNoticesFound>@(RuntimeNotice->Count())</_RuntimeNoticesFound>
      <_ReferencedRuntimePacks>@(_ReferencedRuntimePack->Count())</_ReferencedRuntimePacks>
      <_RuntimeNoticesExpected>$([MSBuild]::Multiply($(_ReferencedRuntimePacks), 2))</_RuntimeNoticesExpected>
    </PropertyGroup>
    <Error Condition="'@(_ReferencedRuntimePack)' == ''" Text="No runtime pack was resolved, so the .NET licence files cannot be copied."/>
    <Error Condition="'$(_RuntimeNoticesFound)' != '$(_RuntimeNoticesExpected)'"
           Text="Expected a LICENSE and a THIRD-PARTY-NOTICES file in each of @(_ReferencedRuntimePack->'%(PackageDirectory)', ', ') but found @(RuntimeNotice, ', '): the .NET licence files cannot be copied."/>
    <Copy SourceFiles="@(RuntimeNotice)"
          DestinationFiles="@(RuntimeNotice->'$(PublishDir)licenses/dotnet/%(Framework)-%(Filename).txt')"/>
  </Target>
</Project>
