# Cathode headless rig settings, read by the cathode-host and cathode-server services.
# After editing: sudo systemctl restart cathode-host cathode-server

# The audio interface, as `sudo -u cathode /opt/cathode/bin/cathode-host --devices` lists it.
# Empty runs the engine without audio (the null backend), which is useful to try the setup first.
CATHODE_DEVICE=

# Sample rate and buffer size in frames. 64 is the target; raise it (128, 256) if the log reports dropouts.
CATHODE_RATE=48000
CATHODE_BUFFER=64

# Further cathode-host options: the device channels for each input and output, the FX loop and the DI out, e.g.
#   --input-map "1;2" --outputs 1,3,0,0 --loop-in 3,4 --loop-out 3,4 --di-out 5,6
CATHODE_HOST_ARGS=

# Where the editor and the API listen. 0.0.0.0 is every network interface; the port is what you open in a browser.
ASPNETCORE_URLS=http://0.0.0.0:5180

# The access token every remote editor needs (the install script generates one). Treat it like a password.
Cathode__Token=
